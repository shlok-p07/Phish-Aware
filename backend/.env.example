APP_NAME="PhishAware ML Service"
ENVIRONMENT="development"

# Exported Colab pipeline placed under backend/models_store/. The artifact is
# gitignored; override these when deploying a differently named/versioned model.
AWARENESS_MODEL_FILENAME="phishing_awareness_v1.joblib"
AWARENESS_METADATA_FILENAME="phishing_awareness_v1.metadata.json"
AWARENESS_MODEL_VERSION="awareness-v1.0.0"

# Comma-separated origins allowed to call this API in CORS_ORIGINS if you
# need to override the defaults (localhost:3000) baked into app/core/config.py
