# MongoDB connection string. Point this at a MongoDB Atlas cluster, or at a
# local Docker instance started with `docker compose up -d mongo`:
#   MONGODB_URI="mongodb://localhost:27017"
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net"
MONGODB_DB="phishaware"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional server-side override for the public origin. Falls back to
# NEXT_PUBLIC_SITE_URL. Set this when the app runs behind a proxy whose public
# URL differs from the build-time value -- it builds the OIDC redirect URI,
# which identity providers match as a literal string.
APP_BASE_URL=""

# 32-byte key (hex or base64) used to encrypt per-org SSO client secrets at
# rest. Generate one with:  openssl rand -base64 32
# Single sign-on degrades gracefully when this is unset: the app still runs and
# password auth is unaffected, but SSO can't be configured or used. Rotating
# this key requires re-entering every organization's client secret.
APP_ENCRYPTION_KEY=""

# --- Local SSO testing only (used by `bun run sso:demo`, never at runtime) ---
# Credentials for a throwaway identity provider so you can exercise the SSO
# flow end to end. See "Testing SSO with Auth0" in the README.
# SSO_TEST_ISSUER must match what the provider publishes EXACTLY -- Auth0's
# includes a trailing slash.
SSO_TEST_ISSUER=""
SSO_TEST_CLIENT_ID=""
SSO_TEST_CLIENT_SECRET=""
SSO_TEST_PROVIDER="auth0"
SSO_TEST_EMPLOYEE="alice@acme.test"

# Groq API key for the adaptive scenario generator (src/server/scenarioGenerator.ts).
# Free tier: console.groq.com/keys. Scenario generation is skipped (falls back
# to the static seed pool) if this is unset.
GROQ_API_KEY=""

# Server-to-server URL for the optional FastAPI awareness model. When missing
# or unavailable, onboarding safely falls back to diagnostic quiz accuracy.
ML_SERVICE_URL="http://localhost:8001"
ML_SERVICE_TIMEOUT_MS="60000"
