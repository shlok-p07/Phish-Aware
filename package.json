{
  "name": "phishaware",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:init": "set -a && . ./.env && set +a && mongosh \"$MONGODB_URI\" phishaware-db/init/01-validators.js && mongosh \"$MONGODB_URI\" phishaware-db/init/02-indexes.js",
    "db:seed": "tsx --env-file=.env src/db/seed-cli.ts",
    "db:migrate-invites": "tsx --env-file=.env src/db/migrate-invited-users.ts",
    "sso:demo": "tsx --env-file=.env src/db/sso-demo.ts",
    "codegen": "orval --config ./src/api-spec/orval.config.ts",
    "test:ui": "vitest run",
    "test:ui:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:all": "bun test && vitest run",
    "db:prune": "bun run scripts/prune-unused-collections.ts",
    "db:verify": "bun run scripts/verify-database.ts",
    "db:migrate-work-type": "bun run scripts/migrate-legacy-work-type.ts",
    "db:dedupe-departments": "bun run scripts/dedupe-departments.ts",
    "db:normalize-sso-domains": "bun run scripts/normalize-sso-domains.ts",
    "db:prune-orphans": "bun run scripts/prune-orphans.ts",
    "db:prune-test-accounts": "bun run scripts/prune-test-accounts.ts"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.101.4",
    "@types/zxcvbn": "^4.4.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "groq-sdk": "^1.5.0",
    "lucide-react": "^0.545.0",
    "mongodb": "^6.21.0",
    "next": "^15.5.23",
    "next-themes": "^0.4.6",
    "openid-client": "^6.8.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-icons": "^5.7.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.10",
    "happy-dom": "^20.11.6",
    "orval": "^8.24.0",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ],
  "overrides": {
    "sharp": "^0.35.0",
    "postcss": "^8.5.23",
    "nanoid": "^3.3.18"
  }
}
