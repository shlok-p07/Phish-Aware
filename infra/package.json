    "test": "node --import tsx --test test/*.check.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "aws-cdk": "2.1147.0",
    "tsx": "4.23.15",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1"
  }
}
